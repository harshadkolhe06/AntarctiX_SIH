# PRAKASH - Environment Configuration Template
# Copy to .env for local overrides if required

# FastAPI Backend & Deployment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=False
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# NASA POWER API Base URL (Public REST API - No Key Required)
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/hourly/point

# Station Coordinates
BHARATI_LAT=-69.408
BHARATI_LON=76.195
MAITRI_LAT=-70.766
MAITRI_LON=11.733
